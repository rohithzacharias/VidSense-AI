# ==============================================================================
# VidSense AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# --- Video Processing & Frame Extraction ---
VIDSENSE_PROCESS_FPS=10
VIDSENSE_CLIP_DURATION=5
VIDSENSE_VLM_FRAMES_PER_CLIP=6

# --- YOLO Object Detection & Tracking ---
VIDSENSE_YOLO_MODEL=yolov8n.pt
VIDSENSE_YOLO_CONFIDENCE=0.35
VIDSENSE_YOLO_DEVICE=0
VIDSENSE_TRACKER=botsort.yaml

# --- Local Vision-Language Model (Qwen2.5-VL via llama-cpp-python) ---
# Number of layers offloaded to GPU:
#   0  = CPU-only
#   20 = Partial GPU offload (~2.5GB VRAM)
#  -1  = Full GPU offload (requires ~4GB+ VRAM)
VIDSENSE_QWEN_GPU_LAYERS=20
VIDSENSE_QWEN_CTX_SIZE=8192
VIDSENSE_QWEN_MAX_TOKENS=512
VIDSENSE_QWEN_TEMPERATURE=0.2

# --- Groq LLM Reasoning Service ---
# Required for natural language Q&A and temporal video queries
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- MongoDB Database ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=vidsense_ai

# --- Application Logging ---
VIDSENSE_LOG_LEVEL=INFO
